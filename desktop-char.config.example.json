{
  "$schema": "./apps/desktop/public/schemas/desktop-char.config.schema.json",
  "version": 1,
  "interaction": {
    "drag": {
      "holdDelayMs": 180
    },
    "conversationSidebar": {
      "preferredSide": "right"
    }
  },
  "window": {
    "defaultSize": { "width": 460, "height": 700 },
    "defaultMarginDip": 24,
    "alwaysOnTop": true
  },
  "applicationCommands": {
    "bindings": {}
  },
  "agentProviders": {
    "codex-managed": {
      "adapter": "codex-app-server",
      "lifecycle": "managed",
      "requestTimeoutMs": 180000
    },
    "router-codex-managed": {
      "adapter": "codex-app-server",
      "lifecycle": "managed",
      "requestTimeoutMs": 180000
    }
  },
  "agentRoles": {
    "char": {
      "provider": "codex-managed",
      "promptProfile": "profiles/char/default.json",
      "maxConcurrency": 2
    },
    "router": {
      "provider": "router-codex-managed",
      "promptProfile": "profiles/router/session-routing.json",
      "temperature": 0,
      "autoSubmitMinConfidence": 0.78,
      "autoSubmitMinMargin": 0.18,
      "maxTimelineEntries": 12,
      "maxCandidates": 6
    }
  },
  "agentHttp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 17373
  },
  "taskManager": {
    "enabled": true,
    "lifecycle": "managed",
    "pollIntervalMs": 250,
    "requestTimeoutMs": 5000,
    "eventPageSize": 100,
    "maxEvents": 200
  },
  "character": {
    "profile": "models/Mao/DesktopChar.character.json"
  },
  "performanceInference": {
    "enabled": false,
    "lifecycle": "external",
    "provider": "qwen35-transformers",
    "baseUrl": "http://127.0.0.1:18090/v1",
    "timeoutMs": 10000,
    "maxOutputTokens": 64,
    "temperature": 0.1,
    "fallbackToRules": true
  },
  "ttsMcp": {
    "autoStart": true,
    "profile": "local"
  },
  "characterMcp": {
    "autoStart": true,
    "host": "127.0.0.1",
    "port": 17374,
    "path": "/mcp",
    "reconnect": {
      "initialDelayMs": 500,
      "maximumDelayMs": 10000
    }
  }
}
