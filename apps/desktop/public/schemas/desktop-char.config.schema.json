{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktopchar.local/schemas/desktop-char.config.schema.json",
  "title": "DesktopChar Application Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drag": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "holdDelayMs": { "type": "integer", "minimum": 0, "maximum": 999 }
          }
        },
        "conversationSidebar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredSide": { "enum": ["left", "right"] }
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "defaultMarginDip": { "type": "number", "minimum": 0 },
        "alwaysOnTop": { "type": "boolean" }
      }
    },
    "agentProviders": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agentProvider" }
    },
    "agentRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "char": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "promptProfile": { "$ref": "#/$defs/applicationAssetPath" },
            "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "router": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "promptProfile": { "$ref": "#/$defs/applicationAssetPath" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "autoSubmitMinConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "autoSubmitMinMargin": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxTimelineEntries": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        }
      }
    },
    "agentHttp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "$ref": "#/$defs/applicationAssetPath" }
      }
    },
    "taskManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "lifecycle": { "enum": ["managed", "external"] },
        "markerPath": { "type": "string", "minLength": 1 },
        "sessionMonitorMarkerPath": { "type": "string", "minLength": 1 },
        "stateDirectory": { "type": "string", "minLength": 1 },
        "startupTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
        "shutdownTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
        "restartOnFailure": { "type": "boolean" },
        "pollIntervalMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "eventPageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxEvents": { "type": "integer", "minimum": 10, "maximum": 2000 }
      }
    },
    "performanceInference": { "$ref": "#/$defs/performanceInference" },
    "ttsMcp": { "$ref": "#/$defs/ttsMcp" },
    "characterMcp": { "$ref": "#/$defs/characterMcp" }
  },
  "$defs": {
    "agentProvider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": { "const": "codex-app-server" },
            "lifecycle": { "const": "managed" },
            "launcherScript": { "type": "string", "minLength": 1 },
            "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "baseUrl", "model", "apiKeyEnv"],
          "properties": {
            "adapter": { "const": "openai-compatible" },
            "baseUrl": { "type": "string", "format": "uri" },
            "model": { "type": "string", "minLength": 1 },
            "apiKeyEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
          }
        }
      ]
    },
    "applicationAssetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "performanceInference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "lifecycle": {
          "oneOf": [
            { "enum": ["external", "managed"] },
            { "$ref": "#/$defs/performanceInferenceLifecycle" }
          ]
        },
        "provider": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "healthUrl": { "type": "string", "format": "uri" },
        "model": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "fallbackToRules": { "type": "boolean" }
      }
    },
    "performanceInferenceLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["external", "managed"] },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "startupTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
        "shutdownTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
        "healthIntervalMs": { "type": "number", "exclusiveMinimum": 0 },
        "restartOnFailure": { "type": "boolean" }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelayMs": { "type": "number", "exclusiveMinimum": 0 },
        "maximumDelayMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "ttsMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoStart": { "type": "boolean" },
        "profile": { "type": "string", "minLength": 1 }
      }
    },
    "ttsMcpProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "version": { "const": 1 },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["external", "managed"] },
            "start": {
              "type": "object",
              "additionalProperties": false,
              "required": ["executable"],
              "properties": {
                "executable": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } },
                "cwd": { "type": "string", "minLength": 1 },
                "env": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            },
            "startupTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "shutdownTimeoutMs": { "type": "number", "exclusiveMinimum": 0 },
            "healthIntervalMs": { "type": "number", "exclusiveMinimum": 0 },
            "restartOnFailure": { "type": "boolean" }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": { "const": "streamable-http" },
            "url": { "type": "string", "format": "uri" },
            "timeoutMs": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": { "const": "desktop-char.tts.streaming" },
            "version": { "const": 1 }
          }
        },
        "synthesis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["wav", "mp3", "ogg", "opus", "pcm_s16le", "pcm_f32le"] },
            "voice": { "type": "string", "minLength": 1 },
            "rate": { "type": "number", "minimum": 0.5, "maximum": 2 }
          }
        },
        "reconnect": { "$ref": "#/$defs/reconnect" }
      }
    },
    "characterMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoStart": { "type": "boolean" },
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/[^?#]*$" },
        "reconnect": { "$ref": "#/$defs/reconnect" }
      }
    }
  }
}
